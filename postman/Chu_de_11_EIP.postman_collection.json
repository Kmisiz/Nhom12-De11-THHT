    {
      "name": "3. Kiểm tra dữ liệu trong Finance",
      "description": "Sau thư mục 1 và 2: 10 khoản, tổng 15.200.000 VND.",
      "item": [
        {
          "name": "Danh sách khoản học phí",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Finance có 10 khoản học phí\", () => pm.expect(list.length).to.eql(10));",
                  "pm.test(\"Tổng tiền = 15,200,000 VND\".replace(/,/g, \".\"), () => pm.expect(list.reduce((s, c) => s + c.amount, 0)).to.eql(15200000));",
                  "pm.test(\"Mọi khoản đều UNPAID\", () => list.forEach(c => pm.expect(c.payment_status).to.eql(\"UNPAID\")));"
                ]
              }
            }
